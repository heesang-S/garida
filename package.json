{
  "name": "garida-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Garida deterministic model-routing workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heesang-S/garida.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "api": "pnpm --filter @garida/http api",
    "build": "pnpm -r --filter './packages/*' --filter './plugins/*' build",
    "check:public-packages": "node scripts/check-public-packages.mjs",
    "check:release": "node scripts/check-release-preflight.mjs",
    "mcp": "pnpm --filter @garida/mcp mcp",
    "report": "pnpm --filter @model-orchestration/executor-core report",
    "route": "pnpm --filter @garida/core build && node packages/router-core/dist/src/cli.js",
    "test": "pnpm -r --filter './packages/*' --filter './plugins/*' test",
    "typecheck": "pnpm -r --filter './packages/*' --filter './plugins/*' typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.27",
    "zod": "^4.4.3"
  }
}
